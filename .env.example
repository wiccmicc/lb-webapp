# Порт HTTP (только plain HTTP, TLS терминируется на Apache/Nginx)
PORT=3000

# Уникальный идентификатор экземпляра (если не задан — берётся hostname + порт)
INSTANCE_ID=app-1

# Адрес общего хранилища (Redis). Общее для всех экземпляров.
REDIS_URL=redis://127.0.0.1:6379

# Секрет для подписи cookie-сессии. Должен быть ОДИНАКОВЫМ на всех экземплярах.
SESSION_SECRET=change-me-to-a-long-random-string
